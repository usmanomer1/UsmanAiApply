# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Browser Use API
VITE_BROWSER_USE_API_KEY=your_browser_use_api_key

# Gemini API (for premium features)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Local Development (optional)
# Set to 'true' to use local Supabase functions (requires `supabase functions serve`)
VITE_USE_LOCAL_FUNCTIONS=false

# Stripe (optional)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_key

# Other optional configs
VITE_DISABLE_CAPTCHA=false
VITE_ENABLE_EXTERNAL_APPLICATIONS=false